From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Neanderfunk <projekt@neanderfunk.de>
Date: Fri, 16 Oct 2026 11:41:51 +0200
Subject: [PATCH 4/4] mpc85xx: relocate BR200-WP, HiveAP-330, WS-AP3715i loader to
 0x3000000

Der simpleImage-Loader dieser drei Geraete liegt seit 6a8b831593 bei
0x1500000. Die 24.10-initramfs-Kernel enden 0.1-0.2 MiB darunter, ein
Gluon-initramfs ist groesser: dann linkt der Wrapper den Loader hoeher,
als der uImage-Header sagt, und das Geraet bleibt nach "Uncompressing
Kernel Image ... OK" stehen (openwrt/openwrt#25302).

Loader und Ladeadresse zusammen auf 0x3000000, wie bei WS-AP3710i und
WS-AP3825i auf main. Inhaltlich openwrt/openwrt#25257 (grische), auf die
6.6-Patches von openwrt-24.10 nach #25541 uebertragen; Hunks in 099 und
107 gegen den unveraenderten Wrapper von 6.6.151 neu erzeugt.
TL-WDR4900 v1 bleibt bei 0x1500000.

Nicht auf Hardware getestet. Pruefbar am Image: Ladeadresse im Header
gleich Linkadresse des Loaders.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 target/linux/mpc85xx/image/p1010.mk                    |  8 ++++----
 target/linux/mpc85xx/image/p1020.mk                    |  4 ++--
 ...hange-wrapper-address-of-simple-image-devices.patch | 10 +++++++++-
 .../107-powerpc-85xx-add-ws-ap3825i-support.patch      |  4 ++--
 4 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/target/linux/mpc85xx/image/p1010.mk b/target/linux/mpc85xx/image/p1010.mk
index c873c29f9d..ddfff8cb3a 100644
--- a/target/linux/mpc85xx/image/p1010.mk
+++ b/target/linux/mpc85xx/image/p1010.mk
@@ -21,8 +21,8 @@ define Device/aerohive_br200-wp
   KERNEL_NAME := simpleImage.br200-wp
   KERNEL := kernel-bin | uImage none
   KERNEL_INITRAMFS := kernel-bin | uImage none
-  KERNEL_ENTRY := 0x1500000
-  KERNEL_LOADADDR := 0x1500000
+  KERNEL_ENTRY := 0x3000000
+  KERNEL_LOADADDR := 0x3000000
   KERNEL_SIZE := 8m
   IMAGES := fdt.bin sysupgrade.bin
   IMAGE/fdt.bin := append-dtb
@@ -39,8 +39,8 @@ define Device/enterasys_ws-ap3715i
   DEVICE_MODEL := WS-AP3715i
   BLOCKSIZE := 64k
   KERNEL_NAME := simpleImage.ws-ap3715i
-  KERNEL_ENTRY := 0x1500000
-  KERNEL_LOADADDR := 0x1500000
+  KERNEL_ENTRY := 0x3000000
+  KERNEL_LOADADDR := 0x3000000
   KERNEL = kernel-bin | lzma | uImage lzma
   IMAGES := sysupgrade.bin
   IMAGE/sysupgrade.bin := append-kernel | append-rootfs | pad-rootfs | append-metadata
diff --git a/target/linux/mpc85xx/image/p1020.mk b/target/linux/mpc85xx/image/p1020.mk
index a40e2620bd..e56f133d85 100644
--- a/target/linux/mpc85xx/image/p1020.mk
+++ b/target/linux/mpc85xx/image/p1020.mk
@@ -22,8 +22,8 @@ define Device/aerohive_hiveap-330
   KERNEL_NAME := simpleImage.hiveap-330
   KERNEL_SIZE := 16m
   IMAGES := sysupgrade.bin
-  KERNEL_ENTRY := 0x1500000
-  KERNEL_LOADADDR := 0x1500000
+  KERNEL_ENTRY := 0x3000000
+  KERNEL_LOADADDR := 0x3000000
   # append-dtb is still needed, as otherwise u-boot bootm complains
   # about not having a FDT to edit.
   IMAGE/sysupgrade.bin := append-dtb | pad-to 256k | append-kernel | \
diff --git a/target/linux/mpc85xx/patches-6.6/099-mpc85xx-p1010-change-wrapper-address-of-simple-image-devices.patch b/target/linux/mpc85xx/patches-6.6/099-mpc85xx-p1010-change-wrapper-address-of-simple-image-devices.patch
index 8888121e6d..23a28e108f 100644
--- a/target/linux/mpc85xx/patches-6.6/099-mpc85xx-p1010-change-wrapper-address-of-simple-image-devices.patch
+++ b/target/linux/mpc85xx/patches-6.6/099-mpc85xx-p1010-change-wrapper-address-of-simple-image-devices.patch
@@ -1,6 +1,14 @@
 --- a/arch/powerpc/boot/wrapper
 +++ b/arch/powerpc/boot/wrapper
-@@ -351,6 +351,7 @@ adder875-redboot)
+@@ -348,9 +348,15 @@ adder875-redboot)
+     platformo="$object/fixed-head.o $object/redboot-8xx.o"
+     binary=y
+     ;;
++simpleboot-br200-wp|simpleboot-hiveap-330|simpleboot-ws-ap3715i)
++    platformo="$object/fixed-head.o $object/simpleboot.o"
++    link_address='0x3000000'
++    binary=y
++    ;;
  simpleboot-*)
      platformo="$object/fixed-head.o $object/simpleboot.o"
      binary=y
diff --git a/target/linux/mpc85xx/patches-6.6/107-powerpc-85xx-add-ws-ap3825i-support.patch b/target/linux/mpc85xx/patches-6.6/107-powerpc-85xx-add-ws-ap3825i-support.patch
index 380e74d733..468ac26c20 100644
--- a/target/linux/mpc85xx/patches-6.6/107-powerpc-85xx-add-ws-ap3825i-support.patch
+++ b/target/linux/mpc85xx/patches-6.6/107-powerpc-85xx-add-ws-ap3825i-support.patch
@@ -55,8 +55,8 @@ WS-AP3825i AP.
  
 --- a/arch/powerpc/boot/wrapper
 +++ b/arch/powerpc/boot/wrapper
-@@ -348,6 +348,11 @@ adder875-redboot)
-     platformo="$object/fixed-head.o $object/redboot-8xx.o"
+@@ -353,6 +353,11 @@ simpleboot-br200-wp|simpleboot-hiveap-330|simpleboot-ws-ap3715i)
+     link_address='0x3000000'
      binary=y
      ;;
 +simpleboot-ws-ap3825i)
-- 
