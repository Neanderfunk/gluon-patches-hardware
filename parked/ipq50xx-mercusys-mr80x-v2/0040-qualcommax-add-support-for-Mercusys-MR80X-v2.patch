diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/09_mount_tp_data b/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/09_mount_tp_data
new file mode 100644
index 0000000000..693bd66494
--- /dev/null
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/09_mount_tp_data
@@ -0,0 +1,30 @@
+#!/bin/sh
+# TP-Link/Mercusys boards keep their factory data (including the 6-byte
+# "default-mac") in the tp_data UBIFS volume. Attach and mount it read-only
+# during preinit so board.d/02_network and the ath11k caldata hotplug can
+# read the MAC without each attaching the volume themselves.
+
+. /lib/functions.sh
+
+preinit_mount_tp_data() {
+	case "$(board_name)" in
+	mercusys,mr80x-v2) ;;
+	*) return ;;
+	esac
+
+	# ubiattach lives in /usr/sbin, which the preinit PATH omits
+	local PATH="/usr/sbin:/usr/bin:$PATH"
+	local mtd_num ubi_num
+
+	mtd_num=$(find_mtd_index tp_data)
+	[ -n "$mtd_num" ] || return
+
+	ubi_num=$(ubiattach -m "$mtd_num" 2>/dev/null | \
+		sed -n 's/.*device number \([0-9]*\).*/\1/p')
+	[ -n "$ubi_num" ] || return
+
+	mkdir -p /tmp/tp_data
+	mount -t ubifs -o ro "ubi${ubi_num}:tp_data" /tmp/tp_data 2>/dev/null
+}
+
+boot_hook_add preinit_main preinit_mount_tp_data
diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
index a206d11496..ad59eb7941 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
@@ -35,6 +35,50 @@ platform_check_image() {
 
 platform_do_upgrade() {
 	case "$(board_name)" in
+	mercusys,mr80x-v2)
+		# A/B: write the inactive slot, then point tp_boot_idx at it.
+		# tp_boot_idx=0 boots "rootfs", 1 boots "rootfs_1". primaryboot
+		# must stay 0, the stock loader and the button recovery pick the
+		# slot by name from tp_boot_idx alone. tp_boot_idx only changes
+		# once the new slot is fully written.
+		local tp active target newtp primaryboot bcidx bcfile
+
+		# Warn only, flipping primaryboot here would desync the running
+		# and the next-boot slot names.
+		bcidx=$(find_mtd_index "0:bootconfig")
+		if [ -n "$bcidx" ]; then
+			bcfile=/tmp/mtd"$bcidx".bin
+			dd if=/dev/mtd"$bcidx" of="$bcfile" bs=1 count=336 2>/dev/null
+			primaryboot=$(get_bootconfig_primaryboot "$bcfile" "rootfs")
+			[ "$primaryboot" = "0" ] || \
+				echo "WARNING: primaryboot=$primaryboot (expected 0); slot selection may be inverted"
+		fi
+
+		tp=$(fw_printenv -n tp_boot_idx 2>/dev/null)
+		case "$tp" in
+			1) active="rootfs_1"; target="rootfs";   newtp=0 ;;
+			*) active="rootfs";   target="rootfs_1"; newtp=1 ;;
+		esac
+
+		if [ -n "$UPGRADE_OPT_USE_CURR_PART" ]; then
+			CI_UBIPART="$active"
+		else
+			CI_UBIPART="$target"
+		fi
+
+		remove_oem_ubi_volume ubi_rootfs
+		remove_oem_ubi_volume wifi_fw
+		remove_oem_ubi_volume bt_fw
+		sync
+		nand_do_flash_file "$1" || nand_do_upgrade_failed
+		if [ -z "$UPGRADE_OPT_USE_CURR_PART" ]; then
+			fw_setenv tp_boot_idx "$newtp" || {
+				echo "failed to set tp_boot_idx"
+				nand_do_upgrade_failed
+			}
+		fi
+		nand_do_upgrade_success
+		;;
 	*)
 		default_do_upgrade "$1"
 		;;
