From: Daniel Palmer <daniel@thingy.jp>
Subject: [PATCH] mtd: spi-nor: add support for Zbit ZB25VQ128

Adds the JEDEC ID 5e 40 18 of the Zbit ZB25VQ128 SPI-NOR flash, which
TOTOLINK has been fitting to the X5000R since 2022.

Port to Linux 6.6 by Freifunk im Neanderland (September 2026): the original
(sent to linux-mtd 2021-09-18, never merged; OpenWrt PR #12396 closed) was
written for 5.15. Under 6.6 the flash_info flags are split into FLAGS() and
NO_SFDP_FLAGS(); the entry uses the same flags as winbond w25q128 and the
same geometry as the original. The manufacturer is appended after xtx.

Kernel 6.6 would also try the generic SFDP fallback (spi-nor-generic) for an
unknown ID; the explicit entry keeps the behaviour that ran under 5.15 in the
field, since no device with this chip is available for testing.

Signed-off-by: Daniel Palmer <daniel@thingy.jp>
---
diff -ruN a/drivers/mtd/spi-nor/Makefile b/drivers/mtd/spi-nor/Makefile
--- a/drivers/mtd/spi-nor/Makefile
+++ b/drivers/mtd/spi-nor/Makefile
@@ -19,6 +19,7 @@
 spi-nor-objs			+= xilinx.o
 spi-nor-objs			+= xmc.o
 spi-nor-objs			+= xtx.o
+spi-nor-objs			+= zbit.o
 spi-nor-$(CONFIG_DEBUG_FS)	+= debugfs.o
 obj-$(CONFIG_MTD_SPI_NOR)	+= spi-nor.o
 
diff -ruN a/drivers/mtd/spi-nor/core.c b/drivers/mtd/spi-nor/core.c
--- a/drivers/mtd/spi-nor/core.c
+++ b/drivers/mtd/spi-nor/core.c
@@ -2019,6 +2019,7 @@
 	&spi_nor_xilinx,
 	&spi_nor_xmc,
 	&spi_nor_xtx,
+	&spi_nor_zbit,
 };
 
 static const struct flash_info spi_nor_generic_flash = {
diff -ruN a/drivers/mtd/spi-nor/core.h b/drivers/mtd/spi-nor/core.h
--- a/drivers/mtd/spi-nor/core.h
+++ b/drivers/mtd/spi-nor/core.h
@@ -655,6 +655,7 @@
 extern const struct spi_nor_manufacturer spi_nor_xilinx;
 extern const struct spi_nor_manufacturer spi_nor_xmc;
 extern const struct spi_nor_manufacturer spi_nor_xtx;
+extern const struct spi_nor_manufacturer spi_nor_zbit;
 
 extern const struct attribute_group *spi_nor_sysfs_groups[];
 
diff -ruN a/drivers/mtd/spi-nor/zbit.c b/drivers/mtd/spi-nor/zbit.c
--- a/drivers/mtd/spi-nor/zbit.c
+++ b/drivers/mtd/spi-nor/zbit.c
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2021, Daniel Palmer<daniel@thingy.jp>
+ */
+
+#include <linux/mtd/spi-nor.h>
+
+#include "core.h"
+
+static const struct flash_info zbit_parts[] = {
+	/* zbit */
+	{ "zb25vq128", INFO(0x5e4018, 0, 64 * 1024, 256)
+		FLAGS(SPI_NOR_HAS_LOCK | SPI_NOR_HAS_TB)
+		NO_SFDP_FLAGS(SECT_4K | SPI_NOR_DUAL_READ |
+			      SPI_NOR_QUAD_READ) },
+};
+
+const struct spi_nor_manufacturer spi_nor_zbit = {
+	.name = "zbit",
+	.parts = zbit_parts,
+	.nparts = ARRAY_SIZE(zbit_parts),
+};
