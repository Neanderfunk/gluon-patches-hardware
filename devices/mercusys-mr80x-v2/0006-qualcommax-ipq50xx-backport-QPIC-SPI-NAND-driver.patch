+change-id: 20250424-qpic-snand-remove-wlen-c0cef3801a7f
+
+Best regards,
+
+--- a/drivers/spi/spi-qpic-snand.c
++++ b/drivers/spi/spi-qpic-snand.c
+@@ -116,7 +116,6 @@ struct qpic_spi_nand {
+ 	struct nand_ecc_engine ecc_eng;
+ 	u8 *data_buf;
+ 	u8 *oob_buf;
+-	u32 wlen;
+ 	__le32 addr1;
+ 	__le32 addr2;
+ 	__le32 cmd;
