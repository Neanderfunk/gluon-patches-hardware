++	bbpos = mtd->writesize - ecc_cfg->cw_size * (num_cw - 1);
++
++	if (snandc->data_buffer[bbpos] == 0xff)
++		snandc->data_buffer[bbpos + 1] = 0xff;
++	if (snandc->data_buffer[bbpos] != 0xff)
