++		goto err_dis_aon_clk;
++
++	ret = clk_prepare_enable(snandc->qspi->iomacro_clk);
++	if (ret)
++		goto err_dis_iom_clk;
++
++	ret = qcom_nandc_alloc(snandc);
++	if (ret)
++		goto err_snand_alloc;
++
++	ret = qcom_spi_init(snandc);
