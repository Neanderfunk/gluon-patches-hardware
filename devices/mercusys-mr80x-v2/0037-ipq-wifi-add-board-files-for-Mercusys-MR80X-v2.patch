From 180049d89ea2130efc67ba70d20182302f51274d Mon Sep 17 00:00:00 2001
From: c127dev <contact@c127.dev>
Date: Thu, 2 Jul 2026 01:42:41 -0500
Subject: [PATCH 37/42] ipq-wifi: add board files for Mercusys MR80X v2
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

IPQ5018 (2.4 GHz) and QCN6122 (5 GHz) board-2.bin, shipped under files/
until submitted to firmware_qca-wireless.

Signed-off-by: Johan Alvarado <contact@c127.dev>

(cherry picked from commit 06d92cffd99ec4cf067053bfb6554f4ee62ce221)

[Neanderfunk: an Kernel 6.6 / OpenWrt 24.10 angepasst: Makefile-Teil von
Hand übertragen (24.10 hat weniger Boards). Die generate-ipq-wifi-package-
Zeile steht am Ende statt alphabetisch, damit CONFLICTS (PREV_BOARD) der
schon vorhandenen ipq-wifi-Pakete, etwa für ipq807x, unverändert bleibt.
Board-Dateien unverändert (sha256 117b7ad9... ipq5018, 0b515b2d...
qcn6122). Das Board gilt auch für den MR3000X v2.0 (gleiche Hardware).]
---
 package/firmware/ipq-wifi/Makefile             |   7 +++++++
 .../files/board-mercusys_mr80x-v2.ipq5018      | Bin 0 -> 131180 bytes
 .../files/board-mercusys_mr80x-v2.qcn6122      | Bin 0 -> 131180 bytes
 3 files changed, 7 insertions(+)
 create mode 100644 package/firmware/ipq-wifi/files/board-mercusys_mr80x-v2.ipq5018
 create mode 100644 package/firmware/ipq-wifi/files/board-mercusys_mr80x-v2.qcn6122

diff --git a/package/firmware/ipq-wifi/Makefile b/package/firmware/ipq-wifi/Makefile
index b741f5d018..c91dd2435d 100644
--- a/package/firmware/ipq-wifi/Makefile
+++ b/package/firmware/ipq-wifi/Makefile
@@ -13,6 +13,11 @@ PKG_FLAGS:=nonshared
 
 include $(INCLUDE_DIR)/package.mk
 
+define Build/Prepare
+	$(call Build/Prepare/Default)
+	$(if $(wildcard ./files/*),$(CP) ./files/* $(PKG_BUILD_DIR)/)
+endef
+
 define Build/Compile
 endef
 
@@ -42,6 +47,7 @@ ALLWIFIBOARDS:= \
 	linksys_mx5300 \
 	linksys_mx8500 \
 	linksys_whw03 \
+	mercusys_mr80x-v2 \
 	netgear_lbr20 \
 	netgear_rax120v2 \
 	netgear_sxk80 \
@@ -210,5 +216,6 @@ $(eval $(call generate-ipq-wifi-package,zte_mf269,ZTE MF269))
 $(eval $(call generate-ipq-wifi-package,zte_mf287,ZTE MF287))
 $(eval $(call generate-ipq-wifi-package,zte_mf287plus,ZTE MF287Plus))
 $(eval $(call generate-ipq-wifi-package,zyxel_nbg7815,Zyxel NBG7815))
+$(eval $(call generate-ipq-wifi-package,mercusys_mr80x-v2,MERCUSYS MR80X v2))
 
 $(foreach PACKAGE,$(ALLWIFIPACKAGES),$(eval $(call BuildPackage,$(PACKAGE))))
diff --git a/package/firmware/ipq-wifi/files/board-mercusys_mr80x-v2.ipq5018 b/package/firmware/ipq-wifi/files/board-mercusys_mr80x-v2.ipq5018
new file mode 100644
