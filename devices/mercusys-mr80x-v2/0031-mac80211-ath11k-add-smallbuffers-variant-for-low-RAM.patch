From b12d5e105d82d0cc0d48d6e79dab71b4f21ff7a3 Mon Sep 17 00:00:00 2001
From: c127dev <contact@c127.dev>
Date: Thu, 2 Jul 2026 01:42:30 -0500
Subject: [PATCH 31/42] mac80211: ath11k: add smallbuffers variant for low-RAM
 devices
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add kmod-ath11k-smallbuffers, mirroring ath10k. It shrinks the ath11k
data path rings and skips the monitor buffer pool when supports_monitor
is false, saving 25-30 MiB per radio on 256 MiB boards.

Also pass C_DEFINES through KCFLAGS: 6.18 kbuild ignores EXTRA_CFLAGS, so
both smallbuffers variants silently built with the default ring sizes.

Signed-off-by: Johan Alvarado <contact@c127.dev>

(cherry picked from commit 662831fb78d4288a94cefd47cabd0e25349a3b4d)

[Neanderfunk: an Kernel 6.6 / OpenWrt 24.10 angepasst: die Zeile
KCFLAGS="$(C_DEFINES)" in MAKE_OPTS weggelassen. Unter Kernel 6.6 wertet
kbuild EXTRA_CFLAGS noch aus (scripts/Makefile.lib: ccflags-y +=
$(EXTRA_CFLAGS)), C_DEFINES kommen also schon an. Ein zweites KCFLAGS auf
der make-Kommandozeile würde das KCFLAGS aus KERNEL_MAKEOPTS
(include/kernel.mk: iremap, CONFIG_EXTRA_OPTIMIZATION,
CONFIG_KERNEL_CFLAGS) für alle mac80211-Module überschreiben, auch in der
regular-Variante. 950 gegen backports 6.12.96 refresht (nur
Zeilenversatz).]
---
 package/kernel/mac80211/Makefile              |   1 +
 package/kernel/mac80211/ath.mk                |  23 +++-
 ...ATH11K_SMALLBUFFERS-option-for-low-m.patch | 120 ++++++++++++++++++
 3 files changed, 140 insertions(+), 4 deletions(-)
 create mode 100644 package/kernel/mac80211/patches/ath11k/950-wifi-ath11k-add-ATH11K_SMALLBUFFERS-option-for-low-m.patch

diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
index a726e110e1..45c9397ae3 100644
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -279,6 +279,7 @@ C_DEFINES=
 
 ifeq ($(BUILD_VARIANT),smallbuffers)
 	C_DEFINES+= -DCONFIG_ATH10K_SMALLBUFFERS
+	C_DEFINES+= -DCONFIG_ATH11K_SMALLBUFFERS
 endif
 
 MAKE_OPTS:= \
diff --git a/package/kernel/mac80211/ath.mk b/package/kernel/mac80211/ath.mk
index 5b13b6aac4..9a7ec6b3aa 100644
--- a/package/kernel/mac80211/ath.mk
+++ b/package/kernel/mac80211/ath.mk
@@ -1,6 +1,6 @@
 PKG_DRIVERS += \
 	ath ath5k ath6kl ath6kl-sdio ath6kl-usb ath9k ath9k-common ath9k-htc ath10k ath10k-smallbuffers \
-	ath11k ath11k-ahb ath11k-pci ath12k carl9170 owl-loader ar5523 wil6210 qcom-qmi-helpers
+	ath11k ath11k-smallbuffers ath11k-ahb ath11k-pci ath12k carl9170 owl-loader ar5523 wil6210 qcom-qmi-helpers
 
 PKG_CONFIG_DEPENDS += \
 	CONFIG_PACKAGE_ATH_DEBUG \
@@ -63,7 +63,8 @@ config-$(CONFIG_ATH11K_THERMAL) += ATH11K_THERMAL
 config-$(call config_package,ath9k-htc) += ATH9K_HTC
 config-$(call config_package,ath10k,regular) += ATH10K ATH10K_PCI
 config-$(call config_package,ath10k-smallbuffers,smallbuffers) += ATH10K ATH10K_PCI ATH10K_SMALLBUFFERS
-config-$(call config_package,ath11k) += ATH11K
+config-$(call config_package,ath11k,regular) += ATH11K
+config-$(call config_package,ath11k-smallbuffers,smallbuffers) += ATH11K ATH11K_SMALLBUFFERS
 config-$(call config_package,ath11k-ahb) += ATH11K_AHB
 config-$(call config_package,ath11k-pci) += ATH11K_PCI
 config-$(call config_package,ath12k) += ATH12K
@@ -304,16 +305,24 @@ define KernelPackage/ath10k-smallbuffers
   VARIANT:=smallbuffers
 endef
 
-define KernelPackage/ath11k
+define KernelPackage/ath11k/Default
   $(call KernelPackage/mac80211/Default)
   TITLE:=Qualcomm 802.11ax wireless chipset support (common code)
   URL:=https://wireless.wiki.kernel.org/en/users/drivers/ath11k
   DEPENDS+= +kmod-ath +@DRIVER_11AC_SUPPORT +@DRIVER_11AX_SUPPORT \
   +kmod-crypto-michael-mic +ATH11K_THERMAL:kmod-hwmon-core \
   +ATH11K_THERMAL:kmod-thermal +kmod-qcom-qmi-helpers
+  PROVIDES:=kmod-ath11k
   FILES:=$(PKG_BUILD_DIR)/drivers/net/wireless/ath/ath11k/ath11k.ko
 endef
 
+define KernelPackage/ath11k
+  $(call KernelPackage/ath11k/Default)
+  VARIANT:=regular
+  DEFAULT_VARIANT:=1
+  CONFLICTS:=kmod-ath11k-smallbuffers
+endef
+
 define KernelPackage/ath11k/description
 This module adds support for Qualcomm Technologies 802.11ax family of
 chipsets.
@@ -323,11 +332,17 @@ define KernelPackage/ath11k/config
 
        config ATH11K_THERMAL
                bool "Enable thermal sensors and throttling support"
-               depends on PACKAGE_kmod-ath11k
+               depends on PACKAGE_kmod-ath11k || PACKAGE_kmod-ath11k-smallbuffers
                default y if TARGET_qualcommax
 
 endef
 
+define KernelPackage/ath11k-smallbuffers
+  $(call KernelPackage/ath11k/Default)
+  TITLE+= (small buffers for low-RAM devices)
+  VARIANT:=smallbuffers
+endef
+
 define KernelPackage/ath11k-ahb
   $(call KernelPackage/mac80211/Default)
   TITLE:=Qualcomm 802.11ax AHB wireless chipset support
diff --git a/package/kernel/mac80211/patches/ath11k/950-wifi-ath11k-add-ATH11K_SMALLBUFFERS-option-for-low-m.patch b/package/kernel/mac80211/patches/ath11k/950-wifi-ath11k-add-ATH11K_SMALLBUFFERS-option-for-low-m.patch
new file mode 100644
index 0000000000..7260ef7fe3
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/950-wifi-ath11k-add-ATH11K_SMALLBUFFERS-option-for-low-m.patch
@@ -0,0 +1,120 @@
+From 6b7cab5fe844fe987e657edbd44d3af39cac0ed5 Mon Sep 17 00:00:00 2001
+From: Johan Alvarado <contact@c127.dev>
+Date: Thu, 11 Jun 2026 12:28:42 -0500
+Subject: [PATCH] wifi: ath11k: add ATH11K_SMALLBUFFERS option for low memory
+ systems
+
+The default data path ring sizes target platforms with 512 MB of RAM or
+more. On a 256 MB IPQ5018 access point the RX buffer pools and the TX
+completion rings alone cost about 38 MiB per pdev: 16 MiB for the 4096
+buffers of rx_refill_buf_ring, another 16 MiB for rxdma_mon_buf_ring,
+and 6 MiB for the 32768 entry TX completion rings of the 3 TCL rings.
+
+The monitor pool is pure waste when hw_params.supports_monitor is false:
+it is only drained under ATH11K_FLAG_MONITOR_STARTED, and that flag can
+never be set because ath11k_mac_register() does not expose the monitor
+interface type. Under the option, skip the replenish there, keeping the
+ring allocated and advertised to firmware, which reclaims ~16 MiB per
+pdev on its own. Everything outside the option keeps its old behaviour.
+
+Add CONFIG_ATH11K_SMALLBUFFERS which shrinks these rings:
+
+  ring                          default  small
+  DP_TX_COMP_RING_SIZE            32768   4096
+  DP_REO_DST_RING_SIZE             2048    512
+  DP_RXDMA_BUF_RING_SIZE           4096   1024
+  DP_RXDMA_MON_STATUS_RING_SIZE    1024    512
+  DP_RXDMA_MONITOR_BUF_RING_SIZE   4096    256
+  DP_RXDMA_MONITOR_DST_RING_SIZE   2048    512
+  DP_RXDMA_MONITOR_DESC_RING_SIZE  4096    512
+
+This saves roughly 25-30 MiB per radio. 1024 RX buffers and 4096 in
+flight TX descriptors per TCL ring are still above what a 2x2 802.11ax
+radio needs at line rate, so throughput is unaffected. Monitor mode
+still works where it is supported, but may drop frames under load.
+
+Signed-off-by: Johan Alvarado <contact@c127.dev>
+---
+--- a/drivers/net/wireless/ath/ath11k/Kconfig
++++ b/drivers/net/wireless/ath/ath11k/Kconfig
+@@ -32,6 +32,17 @@ config ATH11K_PCI
+ 	help
+ 	  This module adds support for PCIE bus
+ 
++config ATH11K_SMALLBUFFERS
++	bool "ath11k reduced ring and buffer sizes for low memory systems"
++	depends on ATH11K
++	help
++	  Shrink the host data path rings and the RX buffer pools, saving
++	  25-30 MB of RAM per radio. Intended for systems with 256 MB or
++	  less, such as IPQ5018 based access points. Throughput is not
++	  affected, monitor mode may drop frames under load.
++
++	  If unsure, say N.
++
+ config ATH11K_DEBUG
+ 	bool "QCA ath11k debugging"
+ 	depends on ATH11K
+--- a/drivers/net/wireless/ath/ath11k/dp.h
++++ b/drivers/net/wireless/ath/ath11k/dp.h
+@@ -209,17 +209,34 @@ struct ath11k_pdev_dp {
+ #define DP_WBM_RELEASE_RING_SIZE	64
+ #define DP_TCL_DATA_RING_SIZE		512
+ #define DP_TCL_DATA_RING_SIZE_WCN6750	2048
++#ifdef CONFIG_ATH11K_SMALLBUFFERS
++#define DP_TX_COMP_RING_SIZE		4096
++#else
+ #define DP_TX_COMP_RING_SIZE		32768
++#endif
+ #define DP_TX_IDR_SIZE			DP_TX_COMP_RING_SIZE
+ #define DP_TCL_CMD_RING_SIZE		32
+ #define DP_TCL_STATUS_RING_SIZE		32
+ #define DP_REO_DST_RING_MAX		4
++#ifdef CONFIG_ATH11K_SMALLBUFFERS
++#define DP_REO_DST_RING_SIZE		512
++#else
+ #define DP_REO_DST_RING_SIZE		2048
++#endif
+ #define DP_REO_REINJECT_RING_SIZE	32
+ #define DP_RX_RELEASE_RING_SIZE		1024
+ #define DP_REO_EXCEPTION_RING_SIZE	128
+ #define DP_REO_CMD_RING_SIZE		256
+ #define DP_REO_STATUS_RING_SIZE		2048
++#ifdef CONFIG_ATH11K_SMALLBUFFERS
++#define DP_RXDMA_BUF_RING_SIZE		1024
++#define DP_RXDMA_REFILL_RING_SIZE	2048
++#define DP_RXDMA_ERR_DST_RING_SIZE	1024
++#define DP_RXDMA_MON_STATUS_RING_SIZE	512
++#define DP_RXDMA_MONITOR_BUF_RING_SIZE	256
++#define DP_RXDMA_MONITOR_DST_RING_SIZE	512
++#define DP_RXDMA_MONITOR_DESC_RING_SIZE	512
++#else
+ #define DP_RXDMA_BUF_RING_SIZE		4096
+ #define DP_RXDMA_REFILL_RING_SIZE	2048
+ #define DP_RXDMA_ERR_DST_RING_SIZE	1024
+@@ -227,6 +244,7 @@ struct ath11k_pdev_dp {
+ #define DP_RXDMA_MONITOR_BUF_RING_SIZE	4096
+ #define DP_RXDMA_MONITOR_DST_RING_SIZE	2048
+ #define DP_RXDMA_MONITOR_DESC_RING_SIZE	4096
++#endif
+ 
+ #define DP_RX_RELEASE_RING_NUM	3
+ 
+--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
++++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
+@@ -501,7 +501,15 @@ static int ath11k_dp_rxdma_pdev_buf_setu
+ 
+ 	ath11k_dp_rxdma_ring_buf_setup(ar, rx_ring, HAL_RXDMA_BUF);
+ 
++#ifdef CONFIG_ATH11K_SMALLBUFFERS
++	/* Without supports_monitor, ATH11K_FLAG_MONITOR_STARTED can never be
++	 * set and nothing ever drains this pool. Leave the ring allocated and
++	 * advertised to firmware, just empty.
++	 */
++	if (ab->hw_params.rxdma1_enable && ab->hw_params.supports_monitor) {
++#else
+ 	if (ar->ab->hw_params.rxdma1_enable) {
++#endif
+ 		rx_ring = &dp->rxdma_mon_buf_ring;
+ 		ath11k_dp_rxdma_ring_buf_setup(ar, rx_ring, HAL_RXDMA_MONITOR_BUF);
+ 	}
-- 
2.53.0

