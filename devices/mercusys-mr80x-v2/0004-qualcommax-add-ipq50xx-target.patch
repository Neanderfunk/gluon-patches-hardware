++++ b/arch/arm64/boot/dts/qcom/ipq5018.dtsi
+@@ -166,6 +166,21 @@
+ 			clock-names = "gcc_mdio_ahb_clk";
+ 
+ 			status = "disabled";
++
++			ge_phy: ethernet-phy@7 {
++				compatible = "ethernet-phy-id004d.d0c0";
