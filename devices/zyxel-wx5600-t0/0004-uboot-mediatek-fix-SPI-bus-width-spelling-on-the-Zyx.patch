From 367969919ae2bc91809b821d05379f0513d577c1 Mon Sep 17 00:00:00 2001
From: Aleksei Sviridkin <f@lex.la>
Date: Thu, 3 Sep 2026 13:53:48 +0000
Subject: [PATCH 4/4] uboot-mediatek: fix SPI bus-width spelling on the Zyxel
 WX5600-T0

No test on this hardware, but the same community U-Boot source that
confirms the Livinet Li320 wiring carries this board too, with
support_quad set on the controller and the same typo in its own DTS.

Yuzhii0718/bl-mt798x-dhcpd, uboot-mtk-20250711/arch/arm/dts/mediatek/
openwrt/mt7986b-zyxel_wx5600-t0.dts.

Assisted-by: LLM
Signed-off-by: Aleksei Sviridkin <f@lex.la>
Link: https://github.com/openwrt/openwrt/pull/24809
Signed-off-by: Jonas Jelonek <jonas@jonasjelonek.de>
(cherry picked from commit 74824d68c6fcf36a2df25c4cfaf5d5192a42c145)
---
 .../boot/uboot-mediatek/patches/471-add-zyzel-wx5600-t0.patch | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/package/boot/uboot-mediatek/patches/471-add-zyzel-wx5600-t0.patch b/package/boot/uboot-mediatek/patches/471-add-zyzel-wx5600-t0.patch
index e06cf811f1..2e43559025 100644
--- a/package/boot/uboot-mediatek/patches/471-add-zyzel-wx5600-t0.patch
+++ b/package/boot/uboot-mediatek/patches/471-add-zyzel-wx5600-t0.patch
@@ -298,8 +298,8 @@
 +		compatible = "spi-nand";
 +		reg = <0>;
 +		spi-max-frequency = <52000000>;
-+		spi-tx-buswidth = <4>;
-+		spi-rx-buswidth = <4>;
++		spi-tx-bus-width = <4>;
++		spi-rx-bus-width = <4>;
 +
 +		partitions {
 +			compatible = "fixed-partitions";
-- 
2.53.0

